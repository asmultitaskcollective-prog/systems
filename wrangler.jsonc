{
  // Cloudflare Workers static-assets deployment (no Worker code: the site is
  // fully pre-rendered). Build with DEPLOY_TARGET=cloudflare or in Workers
  // Builds, then `npx wrangler deploy`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asmc-site",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
